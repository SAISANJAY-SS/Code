# Set either AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or use AWS_PROFILE / an IAM role.
AWS_REGION=us-east-1
AWS_SES_SENDER=verified-sender@example.com
ALERT_EMAIL=fraud-team@example.com
# SNS is disabled for now.
# Also accepts the names used by the attached reference implementation:
# SES_SENDER_EMAIL=verified-sender@example.com
# SES_RECIPIENT_EMAIL=fraud-team@example.com
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:sentinel-fraud-alerts
# Optional local-only secret; use a long random value outside the demo.
JWT_SECRET_KEY=replace-with-a-long-random-secret
# For local IAM user credentials, copy these to backend/.env and fill there only.
# Alternatively configure AWS_PROFILE or use an IAM role; never commit real keys.
# AWS_ACCESS_KEY_ID=PASTE_ACCESS_KEY_ID_HERE
# AWS_SECRET_ACCESS_KEY=PASTE_SECRET_ACCESS_KEY_HERE
# AWS_SESSION_TOKEN=PASTE_SESSION_TOKEN_HERE
