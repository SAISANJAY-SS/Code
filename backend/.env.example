# Set either AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or use AWS_PROFILE / an IAM role.
AWS_REGION=ap-southeast-2
AWS_SES_SENDER=balaambiga7777@gmail.com
ALERT_EMAIL=balaambiga7777@gmail.com
# SNS client region is derived from this topic ARN; it may differ from AWS_REGION.
AWS_SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:617083844092:sentinel-fraud-alerts
# Also accepts the names used by the attached reference implementation:
# SES_SENDER_EMAIL=verified-sender@example.com
# SES_RECIPIENT_EMAIL=fraud-team@example.com
# SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:617083844092:sentinel-fraud-alerts
# Optional local-only secret; use a long random value outside the demo.
JWT_SECRET_KEY=replace-with-a-long-random-secret
