# Set either AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or use AWS_PROFILE / an IAM role.
AWS_REGION=ap-south-1
AWS_SES_SENDER=verified-sender@example.com
ALERT_EMAIL=fraud-team@example.com
AWS_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:sentinel-fraud-alerts
# Optional local-only secret; use a long random value outside the demo.
JWT_SECRET_KEY=replace-with-a-long-random-secret
